{
  "manifest_version": "0.3",
  "name": "videosave",
  "display_name": "VideoSave",
  "version": "1.3.2",
  "description": "Local MCP server for probing and saving authorized media with resumable downloads.",
  "author": {
    "name": "VideoSave Contributors",
    "url": "https://github.com/KaiserIIII/videosave"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KaiserIIII/videosave"
  },
  "homepage": "https://kaiseriiii.github.io/videosave/",
  "documentation": "https://github.com/KaiserIIII/videosave/blob/v1.3.2/docs/mcp.md",
  "icon": "extension/icons/icon-128.png",
  "license": "MIT",
  "privacy_policies": ["https://github.com/KaiserIIII/videosave/blob/v1.3.2/docs/privacy.md"],
  "compatibility": {
    "platforms": ["win32", "darwin", "linux"],
    "runtimes": { "node": ">=24.0.0" }
  },
  "server": {
    "type": "node",
    "entry_point": "tools/mcp-server.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/tools/mcp-server.mjs"]
    }
  },
  "tools_generated": true
}
